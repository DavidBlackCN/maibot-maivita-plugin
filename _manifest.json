{
  "manifest_version": 2,
  "version": "0.3.1",
  "name": "MaiVita Integration Ready Candidate",
  "description": "Versioned Life Runtime with offline engine transitions; privileged integrations safely disabled.",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-maivita-plugin"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.3.12"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.15.0"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=9.0.0"
    },
    {
      "type": "python_package",
      "name": "pytz",
      "version_spec": ">=2024.1"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2024.1"
    }
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.jpg",
      "fallback": "logo",
      "background": "#F0F5FC"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "config.get",
    "llm.generate",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "chat.get_all_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "knowledge.search",
    "maisaka.proactive.trigger",
    "frequency.get_adjust",
    "frequency.get_current_talk_value",
    "component.list_loaded_plugins"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "davidblackcn.maibot-maivita-plugin"
}
