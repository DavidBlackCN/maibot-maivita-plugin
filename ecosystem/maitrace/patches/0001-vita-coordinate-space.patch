diff --git a/services/space_contract.py b/services/space_contract.py
new file mode 100644
index 0000000..ee96e88
--- /dev/null
+++ b/services/space_contract.py
@@ -0,0 +1,66 @@
+"""Small pinned adaptation: public Vita evidence, bounds and shared browse lock."""
+import asyncio
+from datetime import datetime, timezone
+from .limits import publication_budget_seconds
+
+ADAPTATION='vita-coordinate-1'
+UPSTREAM='712c777aab869c68808f186c24dddf4cab3e36d1'
+VITA='davidblackcn.maibot-maivita-plugin'
+
+
+def browse_lock(plugin):
+    if not hasattr(plugin,'_space_browse_lock'): plugin._space_browse_lock=asyncio.Lock()
+    return plugin._space_browse_lock
+
+
+def contract(plugin):
+    c=plugin.config
+    checks={'life_disabled':not c.life.enabled,'schedule_disabled':not c.schedule.enabled,
+        'messaging_disabled':not c.messaging.enabled,'native_post_disabled':not c.routine.post_enabled,
+        'native_browse_disabled':not c.routine.browse_enabled,'chat_material_disabled':not c.send.enable_chat_memory,
+        'whitelist_mode':c.monitor.read_list_type=='whitelist'}
+    # At most 5 feeds and 5 comment replies per feed, plus one comment/like.
+    browse=600+5*(4+6*(c.llm.llm_timeout_seconds+10+60)+5*10)
+    return {'api_version':1,'adaptation':ADAPTATION,'upstream':UPSTREAM,'ready':all(checks.values()),
+        'configuration':checks,'interaction_whitelist':list(c.monitor.read_list),
+        'budgets':{'post':publication_budget_seconds(c),'browse':browse},
+        'round_result_only':True,'max_feeds':5}
+
+
+async def validate_basis(plugin,basis):
+    """Always reread public evidence; a caller's text cannot become private material."""
+    try:
+        response=await plugin.ctx.call_host_method('cap.call',payload={'capability':'api.call',
+            'args':{'api_name':VITA+'.get_public_life_context','version':'1','args':{}}},timeout_ms=3000)
+        value=response.get('result') if response.get('success') is True else None
+        if not value or value.get('ok') is not True: return False,'LIFE_UNAVAILABLE',None
+        data=value['data']
+        age=(datetime.now(timezone.utc)-datetime.fromisoformat(data['as_of'])).total_seconds()
+        if not -5<=age<=30: return False,'LIFE_STALE',None
+        if not data.get('awake'): return False,'SLEEPING',None
+        if data.get('availability',{}).get('state')!='free': return False,'NOT_FREE',None
+        requested=basis['activity']; aid=requested['activity_id']
+        candidates=[data.get('activity')] if basis.get('current') else data.get('history',[])
+        actual=next((a for a in candidates if a and a.get('activity_id')==aid),None)
+        if not actual or actual.get('visibility')!='public_summary' or actual.get('continuity_unknown'):
+            return False,'MATERIAL_INVALIDATED',None
+        if not actual.get('ended_at') and (actual.get('duration_minutes') or 0)<15:
+            return False,'MATERIAL_TOO_RECENT',None
+        return True,'OK',actual
+    except asyncio.CancelledError: raise
+    except Exception: return False,'LIFE_UNAVAILABLE',None
+
+
+async def browse_api(plugin,max_feeds=5,interaction_whitelist=None):
+    if type(max_feeds) is not int or not 1<=max_feeds<=5:
+        return {'result':False,'status':'failed','message':'INVALID_FEED_LIMIT'}
+    if not contract(plugin)['ready']:
+        return {'result':False,'status':'deferred','message':'CONFIGURATION_NOT_READY'}
+    allowed=set(str(q) for q in plugin.config.monitor.read_list)
+    requested=set(interaction_whitelist or [])
+    if not requested or not requested<=allowed:
+        return {'result':False,'status':'deferred','message':'EXPLICIT_WHITELIST_REQUIRED'}
+    from .monitor import run_browse_once
+    success,message=await run_browse_once(plugin,max_feeds=max_feeds,interaction_whitelist=sorted(requested))
+    return {'result':success,'status':'success' if success else 'deferred' if message=='BROWSE_BUSY' else 'failed',
+            'message':message,'round_result_only':True,'max_feeds':max_feeds}
