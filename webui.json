{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "pages": [
    {
      "id": "now",
      "title": "此刻生活",
      "mode": "custom",
      "entry": "webui/life.html",
      "queries": {
        "overview": {
          "api": "ui_snapshot"
        }
      },
      "actions": {
        "manage": {
          "api": "ui_action",
          "parameters": {
            "action": {
              "type": "string",
              "required": true,
              "choices": [
                "replan",
                "plan",
                "sleep",
                "wake",
                "end_note",
                "abandon_note"
              ]
            },
            "request_id": {
              "type": "string",
              "required": true,
              "max_length": 80
            },
            "minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 720
            },
            "activity_id": {
              "type": "string",
              "max_length": 80
            }
          },
          "confirmation": "确定调整生活状态吗？模型操作将占用今日生活额度。"
        }
      }
    },
    {
      "id": "history",
